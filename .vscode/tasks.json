{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "server: run",
      "type": "shell",
      "command": "go run ./cmd/server -env .env",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "go-server",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": ".*rendezvous server \\(HTTP\\) listening.*"
        }
      }
    },
    {
      "label": "frontend-admin: dev",
      "type": "shell",
      "command": "npm run dev -- --host 127.0.0.1",
      "options": {
        "cwd": "${workspaceFolder}/frontend-admin"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*",
          "endsPattern": ".*Local:.*http://127\\.0\\.0\\.1:5173"
        }
      }
    },
    {
      "label": "go: test",
      "type": "shell",
      "command": "go test ./...",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$go"
    },
    {
      "label": "go: test controlstore mysql",
      "type": "shell",
      "command": "go test ./internal/controlstore",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$go"
    },
    {
      "label": "frontend-admin: build",
      "type": "shell",
      "command": "npm run build",
      "options": {
        "cwd": "${workspaceFolder}/frontend-admin"
      },
      "problemMatcher": "$tsc"
    },
    {
      "label": "build: all",
      "type": "shell",
      "command": ".\\build-all.bat",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": ["$go", "$tsc"]
    }
  ]
}
