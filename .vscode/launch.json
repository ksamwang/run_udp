{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Go: 调试服务端",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/server",
      "cwd": "${workspaceFolder}",
      "args": ["-env", "${workspaceFolder}/.env"]
    },
    {
      "name": "Chrome: 调试管理后台",
      "type": "chrome",
      "request": "launch",
      "url": "http://127.0.0.1:5173",
      "webRoot": "${workspaceFolder}/frontend-admin/src",
      "preLaunchTask": "frontend-admin: dev"
    }
  ],
  "compounds": [
    {
      "name": "全栈调试：服务端 + 管理后台",
      "configurations": ["Go: 调试服务端", "Chrome: 调试管理后台"],
      "stopAll": true
    }
  ]
}
